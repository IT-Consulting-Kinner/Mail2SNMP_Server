@page "/dead-letters"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Operator")]
@inject IDeadLetterService DeadLetterService
@inject IJSRuntime JS
@inject ConfirmService Confirm
@inject IOptions<HelpSettings> Help
@inject ILicenseProvider LicenseProvider

<PageTitle>Dead Letters - Mail2SNMP</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Dead Letters <HelpLink Url="@Help.Value.DeadLetters" /></h3>
    <button class="btn btn-outline-success btn-sm" @onclick="ExportCsv" disabled="@(_totalCount == 0)">
        <i class="bi bi-download"></i> Export CSV
    </button>
</div>

<AutoDismissAlert Type="danger"  @bind-Message="_error" />
<AutoDismissAlert Type="success" @bind-Message="_success" AutoDismissSeconds="5" />

@* Automatic retry is an Enterprise feature (DeadLetterRetryService exits at startup
   under Community), but the page offered Retry buttons in every edition and reported
   "queued for retry" — a queue nothing would ever drain. Say so plainly instead. *@
@if (!LicenseProvider.IsEnterprise())
{
    <div class="alert alert-warning">
        <strong>Automatic retry is an Enterprise feature.</strong>
        Failed deliveries are recorded here so you can see what was lost, but the
        retry worker does not run under the Community edition — re-queued entries
        stay pending. Upgrade to Enterprise to have them delivered automatically.
    </div>
}

@* The listing used to load the newest 500 rows and page them client-side, with no
   filter and no total. On a queue larger than that the page silently presented a
   truncated view as the whole queue, and Abandoned entries — the ones nothing will
   ever retry, so the ones an operator most needs — were unreachable behind newer
   Pending rows. Filters and paging now run server-side against the real count. *@
<div class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small mb-1" for="dl-status">Status</label>
        <select id="dl-status" class="form-select form-select-sm" @bind="_statusFilter" @bind:after="ApplyFilters">
            <option value="">All statuses</option>
            @foreach (var s in Enum.GetValues<DeadLetterStatus>())
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-1" for="dl-kind">Target</label>
        <select id="dl-kind" class="form-select form-select-sm" @bind="_kindFilter" @bind:after="ApplyFilters">
            <option value="">All targets</option>
            <option value="@nameof(DeadLetterTargetKind.Webhook)">HTTP webhook</option>
            <option value="@nameof(DeadLetterTargetKind.Snmp)">SNMP trap</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary btn-sm" @onclick="ClearFilters"
                disabled="@(_statusFilter.Length == 0 && _kindFilter.Length == 0)">Clear filters</button>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"><span class="visually-hidden">Loading...</span></div></div>
}
else if (_entries.Count == 0)
{
    <div class="alert alert-info">
        @(_statusFilter.Length == 0 && _kindFilter.Length == 0
            ? "No dead letter entries found."
            : "No dead letter entries match the selected filters.")
    </div>
}
else
{
    var totalPages = Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));
    var paged = _entries;
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                @* UC-3: the queue holds SNMP entries too — the column shows either kind. *@
                <th>Target</th>
                <th>Event ID</th>
                <th>Status</th>
                <th>Attempts</th>
                <th>Last Error</th>
                <th>Created</th>
                <th>Next Retry</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in paged)
            {
                <tr>
                    <td>@entry.Id</td>
                    @* UC-3: an entry references either a webhook target or an SNMP target. *@
                    <td>
                        @if (entry.SnmpTargetId is not null)
                        {
                            <span class="badge bg-info text-dark me-1">SNMP</span>@(entry.SnmpTarget?.Name ?? $"ID:{entry.SnmpTargetId}")
                        }
                        else
                        {
                            <span class="badge bg-primary me-1">HTTP</span>@(entry.WebhookTarget?.Name ?? $"ID:{entry.WebhookTargetId}")
                        }
                    </td>
                    <td>@entry.EventId</td>
                    <td><span class="badge bg-@GetStatusColor(entry.Status)">@entry.Status</span></td>
                    <td>@entry.AttemptCount</td>
                    <td class="small text-truncate" style="max-width: 200px;" title="@entry.LastError">@entry.LastError</td>
                    <td class="small">@entry.CreatedUtc.ToString("g")</td>
                    <td class="small">@(entry.NextRetryUtc?.ToString("g") ?? "N/A")</td>
                    <td>
                        @if (entry.Status == DeadLetterStatus.Pending)
                        {
                            @* I8: show a spinner while a retry is in flight so the user has visible feedback. *@
                            <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => Retry(entry.Id)" disabled="@_busy">
                                @if (_busy)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-clockwise"></i>
                                }
                                Retry
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<nav class="d-flex justify-content-between align-items-center" aria-label="Pagination">
    <div>
        <small class="text-muted me-3">Showing @((_currentPage - 1) * PageSize + 1)–@((_currentPage - 1) * PageSize + _entries.Count) of @_totalCount entries</small>
        <AuthorizeView Policy="Admin"><Authorized>
            @* Acts on every entry matching the current filter, not just the visible page —
               and says how many that is, so the operator can see what they are about to do. *@
            <button class="btn btn-warning btn-sm" @onclick="RetryAll" disabled="@_busy">
                Retry all @_totalCount matching
            </button>
        </Authorized></AuthorizeView>
    </div>
    @if (totalPages > 1)
    {
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => GoToPage(_currentPage - 1)">Previous</button>
            </li>
            <li class="page-item disabled" aria-current="page"><span class="page-link">Page @_currentPage of @totalPages</span></li>
            <li class="page-item @(_currentPage == totalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => GoToPage(_currentPage + 1)">Next</button>
            </li>
        </ul>
    }
</nav>
}

@code {
    // V1: page floor is Operator; Retry-All is Admin (mirrors the REST API).
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<DeadLetterEntry> _entries = Array.Empty<DeadLetterEntry>();
    private int _totalCount;
    private string? _error;
    private string? _success;
    private bool _loading = true;
    private bool _busy;
    private const int PageSize = 50;
    private int _currentPage = 1;

    // Bound to the two <select> elements. Empty string = no restriction; parsed into
    // the nullable enums the query takes.
    private string _statusFilter = string.Empty;
    private string _kindFilter = string.Empty;

    private DeadLetterQuery CurrentFilter() => new()
    {
        Status = Enum.TryParse<DeadLetterStatus>(_statusFilter, out var s) ? s : null,
        Kind = Enum.TryParse<DeadLetterTargetKind>(_kindFilter, out var k) ? k : null
    };

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task ApplyFilters()
    {
        _currentPage = 1;
        await LoadData();
    }

    private async Task ClearFilters()
    {
        _statusFilter = string.Empty;
        _kindFilter = string.Empty;
        await ApplyFilters();
    }

    private async Task GoToPage(int page)
    {
        var totalPages = Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));
        var target = Math.Clamp(page, 1, totalPages);
        if (target == _currentPage) return;
        _currentPage = target;
        await LoadData(resetPage: false);
    }

    private async Task LoadData(bool resetPage = true)
    {
        _loading = true;
        try
        {
            if (resetPage) _currentPage = 1;

            var filter = CurrentFilter();
            filter.Skip = (_currentPage - 1) * PageSize;
            filter.Take = PageSize;

            var result = await DeadLetterService.QueryAsync(filter);

            // A delete or a drained retry between renders can leave the current page past
            // the end of the result set; step back rather than showing an empty page.
            if (result.Entries.Count == 0 && result.TotalCount > 0 && _currentPage > 1)
            {
                _currentPage = Math.Max(1, (int)Math.Ceiling(result.TotalCount / (double)PageSize));
                filter.Skip = (_currentPage - 1) * PageSize;
                result = await DeadLetterService.QueryAsync(filter);
            }

            _entries = result.Entries;
            _totalCount = result.TotalCount;
        }
        catch (Exception ex) { _error = ErrorMessageFormatter.ToFriendly(ex, "loading data"); }
        finally { _loading = false; }
    }

    private async Task Retry(long id)
    {
        if (_busy) return;
        _busy = true;
        try { await DeadLetterService.RetryAsync(id); _success = "Retry queued."; await LoadData(); }
        catch (Exception ex) { _error = ErrorMessageFormatter.ToFriendly(ex, "retrying the entry"); }
        finally { _busy = false; }
    }

    private async Task RetryAll()
    {
        if (_busy) return;
        if (!await RoleGuard.HasAnyRoleAsync(AuthState, "Admin")) { _error = "Administrator role required."; return; }
        if (_totalCount == 0)
        {
            _error = "No entries to retry.";
            return;
        }
        if (!await Confirm.AskAsync(
                $"Retry {_totalCount} dead letter entries matching the current filter? " +
                "This may send many webhook requests and SNMP traps."))
            return;
        _busy = true;
        try
        {
            // One kind-neutral call: the service re-queues webhook and SNMP entries the
            // same way. This used to be an N+1 loop — one bulk call per webhook target
            // plus one individual call per SNMP row — which also applied *different*
            // resets to the two kinds. It also only ever covered the loaded 500 rows.
            var count = await DeadLetterService.RetryAllAsync(CurrentFilter());
            _success = $"{count} entr{(count == 1 ? "y" : "ies")} queued for retry.";
            await LoadData();
        }
        catch (Exception ex) { _error = ErrorMessageFormatter.ToFriendly(ex, "retrying all entries"); }
        finally { _busy = false; }
    }

    // T15: CSV export — same pattern as AuditLog and Events.
    private async Task ExportCsv()
    {
        if (_totalCount == 0) return;
        try
        {
            // Export the whole filtered set, not just the page on screen — a CSV named
            // "deadletters-<timestamp>" that silently contained 50 of 12 000 rows would
            // be worse than no export. Still bounded by DeadLetterQuery.MaxTake; the
            // header line below says so when the cap bites.
            var exportFilter = CurrentFilter();
            exportFilter.Take = DeadLetterQuery.MaxTake;
            var export = await DeadLetterService.QueryAsync(exportFilter);

            var sb = new System.Text.StringBuilder();
            @* UC-3 (verified fix): entries reference either target kind — the export
               carries a Kind discriminator and both target-id columns. *@
            sb.AppendLine("CreatedUtc,Kind,WebhookTargetId,SnmpTargetId,EventId,Status,AttemptCount,NextRetryUtc,LastError");
            foreach (var e in export.Entries)
            {
                sb.Append(e.CreatedUtc.ToString("o")).Append(',')
                  .Append(e.SnmpTargetId is not null ? "SNMP" : "HTTP").Append(',')
                  .Append(e.WebhookTargetId).Append(',')
                  .Append(e.SnmpTargetId).Append(',')
                  .Append(e.EventId).Append(',')
                  .Append(Csv(e.Status.ToString())).Append(',')
                  .Append(e.AttemptCount).Append(',')
                  .Append(e.NextRetryUtc?.ToString("o") ?? string.Empty).Append(',')
                  .AppendLine(Csv(e.LastError));
            }
            var filename = $"deadletters-{DateTime.UtcNow:yyyyMMdd-HHmmss}.csv";
            await JS.InvokeVoidAsync("mail2snmp.downloadText", filename, "text/csv;charset=utf-8", sb.ToString());

            _success = export.TotalCount > export.Entries.Count
                ? $"Exported the newest {export.Entries.Count} of {export.TotalCount} matching entries (export is capped at {DeadLetterQuery.MaxTake} rows). Narrow the filter to export the rest."
                : $"Exported {export.Entries.Count} entr{(export.Entries.Count == 1 ? "y" : "ies")}.";
        }
        catch (Exception ex) { _error = ErrorMessageFormatter.ToFriendly(ex, "exporting dead letters"); }
    }

    // V5: shared helper also neutralizes spreadsheet formula injection.
    private static string Csv(string? value) => CsvCell.Quote(value);

    private static string GetStatusColor(DeadLetterStatus s) => s switch
    {
        DeadLetterStatus.Pending => "warning",
        DeadLetterStatus.Locked => "info",
        DeadLetterStatus.Abandoned => "danger",
        _ => "secondary"
    };
}
