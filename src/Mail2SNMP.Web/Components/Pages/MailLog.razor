@page "/mail-log"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ReadOnly")]
@using Mail2SNMP.Infrastructure.Data
@using Mail2SNMP.Models.Entities
@using Mail2SNMP.Models.Enums
@using Microsoft.EntityFrameworkCore
@inject Mail2SnmpDbContext Db

<PageTitle>Mail Log - Mail2SNMP</PageTitle>

<h3><i class="bi bi-envelope-paper"></i> Mail Log</h3>
@* UC-5: per-mail disposition trace. Answers "we emailed an alert at 03:14 and
   got no trap — why?" directly from the product: every inbound mail shows
   whether it matched, was deduplicated into an existing event, was suppressed
   by a maintenance window, or simply did not match the job's rule. *@
<p class="text-muted">
    Every processed inbound mail and its outcome. Use this to trace why a mail
    did or did not produce a notification.
</p>

<AutoDismissAlert Type="danger" @bind-Message="_error" />

@* The search box is rendered unconditionally, OUTSIDE the loading branch. The
   filter runs server-side, so re-querying flips the loading flag — if the input
   lived inside the branch it was torn out of the DOM on every keystroke-triggered
   search, losing focus and swallowing characters typed while the query ran. It
   also has to survive an empty result, which previously showed a false
   "no mails recorded" state and dead-ended the page. *@
<div class="mb-3" style="max-width:300px;">
    <DebouncedSearchInput Value="_searchTerm" ValueChanged="OnSearchChanged"
                          Placeholder="Search by sender or subject…" />
</div>

@if (_loading)
{
    <div class="spinner-border" role="status"><span class="visually-hidden">Loading…</span></div>
}
else
{
    @if (_mails.Count == 0)
    {
        @if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            <div class="alert alert-info">No processed mails recorded yet.</div>
        }
        else
        {
            <div class="alert alert-info">No mails match your search.</div>
        }
    }
    else
    {
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Received (UTC)</th>
                    <th>Mailbox</th>
                    <th>From</th>
                    <th>Subject</th>
                    <th>Outcome</th>
                    <th>Event</th>
                    @* The trace used to stop at event creation, so the page answered
                       "did this mail become an event?" but not "did anyone get told?" —
                       which is the actual question behind "we emailed at 03:14 and got
                       no trap". The delivery half is read back from the event's state
                       and its dead letters. *@
                    <th>Delivery</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in _mails)
                {
                    <tr>
                        <td class="text-nowrap">@m.ReceivedUtc.ToString("g")</td>
                        <td>@(m.Mailbox?.Name ?? $"ID:{m.MailboxId}")</td>
                        <td class="text-truncate" style="max-width:220px;" title="@m.From">@m.From</td>
                        <td class="text-truncate" style="max-width:320px;" title="@m.Subject">@m.Subject</td>
                        <td>
                            <span class="badge @DispositionBadge(m.Disposition)">@DispositionLabel(m.Disposition)</span>
                        </td>
                        <td>
                            @if (m.EventId is long evtId)
                            {
                                <a href="/events" title="Opens the events list — the event may need to be located by id #@evtId (older events may already be purged by retention)">#@evtId</a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @{ var delivery = DeliveryOf(m); }
                            <span class="badge @delivery.Badge" title="@delivery.Title">@delivery.Label</span>
                            @if (delivery.DeadLetters > 0)
                            {
                                <a class="ms-1 small" href="/dead-letters">view</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">
        Showing the most recent @_mails.Count entries. Older entries are removed by
        data retention (Retention:ProcessedMailDays).
    </p>
    }
}

@code {
    private const int MaxRows = 200;

    private IReadOnlyList<ProcessedMail> _mails = Array.Empty<ProcessedMail>();
    private bool _loading = true;
    private string? _error;
    private string _searchTerm = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task OnSearchChanged(string value)
    {
        _searchTerm = value;
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var query = Db.ProcessedMails.AsNoTracking()
                .Include(m => m.Mailbox)
                .AsQueryable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm;
                query = query.Where(m =>
                    (m.From != null && m.From.Contains(term)) ||
                    (m.Subject != null && m.Subject.Contains(term)));
            }

            // Ordered by the column the table actually displays. It used to sort by
            // ProcessedUtc while showing ReceivedUtc — for most mail the two are seconds
            // apart, but while a backlog drains they diverge and the list reads as
            // unsorted. ReceivedUtc is also what the date filter uses, so filter and sort
            // now share one index instead of forcing a sort over the whole table.
            _mails = await query
                .OrderByDescending(m => m.ReceivedUtc)
                .ThenByDescending(m => m.Id)
                .Take(MaxRows)
                .ToListAsync();

            await LoadDeliveryAsync();
        }
        catch (Exception ex)
        {
            _error = Helpers.ErrorMessageFormatter.ToFriendly(ex, "loading the mail log");
        }
        finally
        {
            _loading = false;
        }
    }

    // Delivery state of the events this page's mails produced, keyed by event id.
    // ProcessedMail.EventId is deliberately NOT a foreign key — retention purges events
    // on a different schedule than mail traces — so this is a manual lookup and a missing
    // entry legitimately means "the event has already been purged", not "no event".
    private Dictionary<long, EventState> _eventStates = new();
    private Dictionary<long, int> _openDeadLetters = new();

    private async Task LoadDeliveryAsync()
    {
        var eventIds = _mails.Where(m => m.EventId.HasValue).Select(m => m.EventId!.Value).Distinct().ToList();
        if (eventIds.Count == 0)
        {
            _eventStates = new();
            _openDeadLetters = new();
            return;
        }

        // Two set-based queries for the whole page rather than one per row.
        _eventStates = await Db.Events.AsNoTracking()
            .Where(e => eventIds.Contains(e.Id))
            .Select(e => new { e.Id, e.State })
            .ToDictionaryAsync(e => e.Id, e => e.State);

        _openDeadLetters = await Db.DeadLetterEntries.AsNoTracking()
            .Where(d => eventIds.Contains(d.EventId) && d.Status != DeadLetterStatus.Locked)
            .GroupBy(d => d.EventId)
            .Select(g => new { EventId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(g => g.EventId, g => g.Count);
    }

    private record DeliveryView(string Label, string Badge, string Title, int DeadLetters);

    /// <summary>
    /// Renders the second half of the trace: what happened to the event this mail produced.
    /// </summary>
    private DeliveryView DeliveryOf(ProcessedMail mail)
    {
        if (mail.EventId is not long id)
        {
            // No event was raised, so there was nothing to deliver — the Outcome column
            // already explains why.
            return new("—", "bg-light text-muted", "No event was raised for this mail.", 0);
        }

        _openDeadLetters.TryGetValue(id, out var dead);

        if (!_eventStates.TryGetValue(id, out var state))
        {
            return new("purged", "bg-light text-muted",
                "The event has been removed by retention; its delivery outcome is no longer available.", dead);
        }

        if (dead > 0)
        {
            return new($"failed ({dead})", "bg-danger",
                $"{dead} delivery attempt(s) for this event are in the dead-letter queue.", dead);
        }

        return state switch
        {
            EventState.Suppressed => new("suppressed", "bg-warning text-dark",
                "A maintenance window was active, so no notification was sent.", 0),
            EventState.New => new("not delivered", "bg-danger",
                "The event was created but no channel reported a successful delivery.", 0),
            EventState.Expired => new("not delivered", "bg-danger",
                "The event expired without any channel reporting a successful delivery.", 0),
            _ => new("delivered", "bg-success",
                "At least one channel reported a successful delivery.", 0)
        };
    }

    private static string DispositionBadge(MailDisposition d) => d switch
    {
        MailDisposition.EventCreated => "bg-success",
        MailDisposition.Deduplicated => "bg-info text-dark",
        MailDisposition.MaintenanceSuppressed => "bg-warning text-dark",
        MailDisposition.RateLimited => "bg-danger",
        MailDisposition.NoMatch => "bg-secondary",
        _ => "bg-light text-dark border",
    };

    private static string DispositionLabel(MailDisposition d) => d switch
    {
        MailDisposition.EventCreated => "Event created",
        MailDisposition.Deduplicated => "Deduplicated",
        MailDisposition.MaintenanceSuppressed => "Maintenance",
        // H-2: a matched mail that lost to the hourly event budget — surfaced so a
        // missing alert is explainable instead of invisible.
        MailDisposition.RateLimited => "Rate-limited",
        MailDisposition.NoMatch => "No match",
        _ => "Unknown",
    };
}
