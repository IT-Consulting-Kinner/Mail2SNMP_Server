@page "/mail-log"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ReadOnly")]
@using Mail2SNMP.Infrastructure.Data
@using Mail2SNMP.Models.Entities
@using Mail2SNMP.Models.Enums
@using Microsoft.EntityFrameworkCore
@inject Mail2SnmpDbContext Db

<PageTitle>Mail Log - Mail2SNMP</PageTitle>

<h3><i class="bi bi-envelope-paper"></i> Mail Log</h3>
@* UC-5: per-mail disposition trace. Answers "we emailed an alert at 03:14 and
   got no trap — why?" directly from the product: every inbound mail shows
   whether it matched, was deduplicated into an existing event, was suppressed
   by a maintenance window, or simply did not match the job's rule. *@
<p class="text-muted">
    Every processed inbound mail and its outcome. Use this to trace why a mail
    did or did not produce a notification.
</p>

<AutoDismissAlert Type="danger" @bind-Message="_error" />

@* The search box is rendered unconditionally, OUTSIDE the loading branch. The
   filter runs server-side, so re-querying flips the loading flag — if the input
   lived inside the branch it was torn out of the DOM on every keystroke-triggered
   search, losing focus and swallowing characters typed while the query ran. It
   also has to survive an empty result, which previously showed a false
   "no mails recorded" state and dead-ended the page. *@
<div class="mb-3" style="max-width:300px;">
    <DebouncedSearchInput Value="_searchTerm" ValueChanged="OnSearchChanged"
                          Placeholder="Search by sender or subject…" />
</div>

@if (_loading)
{
    <div class="spinner-border" role="status"><span class="visually-hidden">Loading…</span></div>
}
else
{
    @if (_mails.Count == 0)
    {
        @if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            <div class="alert alert-info">No processed mails recorded yet.</div>
        }
        else
        {
            <div class="alert alert-info">No mails match your search.</div>
        }
    }
    else
    {
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Received (UTC)</th>
                    <th>Mailbox</th>
                    <th>From</th>
                    <th>Subject</th>
                    <th>Outcome</th>
                    <th>Event</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in _mails)
                {
                    <tr>
                        <td class="text-nowrap">@m.ReceivedUtc.ToString("g")</td>
                        <td>@(m.Mailbox?.Name ?? $"ID:{m.MailboxId}")</td>
                        <td class="text-truncate" style="max-width:220px;" title="@m.From">@m.From</td>
                        <td class="text-truncate" style="max-width:320px;" title="@m.Subject">@m.Subject</td>
                        <td>
                            <span class="badge @DispositionBadge(m.Disposition)">@DispositionLabel(m.Disposition)</span>
                        </td>
                        <td>
                            @if (m.EventId is long evtId)
                            {
                                <a href="/events" title="Opens the events list — the event may need to be located by id #@evtId (older events may already be purged by retention)">#@evtId</a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">
        Showing the most recent @_mails.Count entries. Older entries are removed by
        data retention (Retention:ProcessedMailDays).
    </p>
    }
}

@code {
    private const int MaxRows = 200;

    private IReadOnlyList<ProcessedMail> _mails = Array.Empty<ProcessedMail>();
    private bool _loading = true;
    private string? _error;
    private string _searchTerm = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task OnSearchChanged(string value)
    {
        _searchTerm = value;
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var query = Db.ProcessedMails.AsNoTracking()
                .Include(m => m.Mailbox)
                .AsQueryable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm;
                query = query.Where(m =>
                    (m.From != null && m.From.Contains(term)) ||
                    (m.Subject != null && m.Subject.Contains(term)));
            }

            _mails = await query
                .OrderByDescending(m => m.ProcessedUtc)
                .Take(MaxRows)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            _error = Helpers.ErrorMessageFormatter.ToFriendly(ex, "loading the mail log");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string DispositionBadge(MailDisposition d) => d switch
    {
        MailDisposition.EventCreated => "bg-success",
        MailDisposition.Deduplicated => "bg-info text-dark",
        MailDisposition.MaintenanceSuppressed => "bg-warning text-dark",
        MailDisposition.RateLimited => "bg-danger",
        MailDisposition.NoMatch => "bg-secondary",
        _ => "bg-light text-dark border",
    };

    private static string DispositionLabel(MailDisposition d) => d switch
    {
        MailDisposition.EventCreated => "Event created",
        MailDisposition.Deduplicated => "Deduplicated",
        MailDisposition.MaintenanceSuppressed => "Maintenance",
        // H-2: a matched mail that lost to the hourly event budget — surfaced so a
        // missing alert is explainable instead of invisible.
        MailDisposition.RateLimited => "Rate-limited",
        MailDisposition.NoMatch => "No match",
        _ => "Unknown",
    };
}
