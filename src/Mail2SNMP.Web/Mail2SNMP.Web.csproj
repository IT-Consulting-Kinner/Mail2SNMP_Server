<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Mail2SNMP.Models\Mail2SNMP.Models.csproj" />
    <ProjectReference Include="..\Mail2SNMP.Core\Mail2SNMP.Core.csproj" />
    <ProjectReference Include="..\Mail2SNMP.Infrastructure\Mail2SNMP.Infrastructure.csproj" />
    <ProjectReference Include="..\Mail2SNMP.Api\Mail2SNMP.Api.csproj" />
    <ProjectReference Include="..\Mail2SNMP.Worker\Mail2SNMP.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.25" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.9.0" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Web is the all-in-one host: it references both Mail2SNMP.Api and Mail2SNMP.Worker,
    so their appsettings*.json flow into this project's publish set and collide with
    Web's own (NETSDK1152). Suppressing the error instead of resolving it would let an
    arbitrary one of the three win, which for a configuration file means the shipped
    settings depend on build order.

    Web's own configuration is the one the all-in-one host reads at runtime, so the
    copies contributed by the referenced projects are dropped here. The standalone Api
    and Worker publishes are produced from their own projects and are unaffected.
  -->
  <Target Name="DropReferencedHostAppSettings" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RelativePath)', '^appsettings.*\.json$'))
                   AND !$([System.String]::Copy('%(Identity)').Contains('Mail2SNMP.Web'))" />
    </ItemGroup>
  </Target>

</Project>
